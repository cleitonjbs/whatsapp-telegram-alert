# Token usado para validar a inscrição de webhook na Meta
WABA_VERIFY_TOKEN=seu_token_de_verificacao

# Token de acesso da API do WhatsApp Business (mantido para referência futura)
WABA_ACCESS_TOKEN=seu_access_token_waba

# Token do bot do Telegram (obtido via @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID do chat/grupo onde os alertas devem ser enviados
TELEGRAM_CHAT_ID=-1001234567890

# (Opcional) Chave da OpenAI para summaries aprimorados via LLM
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opcional) Modelo OpenAI a ser utilizado (padrão: gpt-3.5-turbo)
OPENAI_MODEL=gpt-3.5-turbo

# Porta em que o servidor Express vai ouvir (padrão: 3000)
PORT=3000
